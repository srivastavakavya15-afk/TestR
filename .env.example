# Copy to .env and fill in to turn on the OAuth2/OIDC bonus for docker-compose.
# Leave AUTH_ENABLED=false (or delete this file) to run the app with no identity provider.
#
# The frontend values are baked into the SPA bundle at image build time, so re-run
# `docker compose up --build` after changing them.

AUTH_ENABLED=false

# --- Microsoft Entra ID ---
# OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<spa-application-client-id>
# OIDC_AUDIENCE=api://<api-application-client-id>
# OIDC_SCOPE=openid profile email api://<api-application-client-id>/access_as_user

# --- Auth0 ---
# OIDC_AUTHORITY=https://<your-tenant>.auth0.com/
# OIDC_CLIENT_ID=<spa-client-id>
# OIDC_AUDIENCE=https://testr-api          # the API identifier, required for a JWT access token
# OIDC_SCOPE=openid profile email
